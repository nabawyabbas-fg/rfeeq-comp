# Rfeeq — environment
#
# Copy to `.env` at the repo root and fill in. Everything under “Required” must
# be set before the app will boot: the schema in `apps/web/src/env.ts` validates
# at startup and fails loudly rather than letting a missing key surface later as
# a broken request.
#
# Keys are grouped by what stops working without them, so a local install can
# skip whole sections knowingly instead of guessing.


# ─── Required ────────────────────────────────────────────────────────────────

# Postgres. `DIRECT_URL` is the unpooled connection Prisma migrates over; point
# both at the same database when you are not behind a pooler.
DATABASE_URL=postgresql://user:password@localhost:5432/rfeeq
DIRECT_URL=postgresql://user:password@localhost:5432/rfeeq

# Sessions. Generate the secret with `openssl rand -base64 32`.
# BETTER_AUTH_URL is the origin the app is reached at — it must match the
# address in the browser, or the OAuth round trip comes back to the wrong host.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Who the app thinks it is. ORIGIN carries the scheme because behind a
# TLS-terminating proxy the app would otherwise assemble `http://` + host and
# redirect out of https.
NEXT_PUBLIC_APP_NAME=Rfeeq
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_HOSTS=localhost:3000
NEXT_PUBLIC_APP_SHORT_DOMAIN=localhost:3000

# The organisation every signup is attached to. Create one row in the
# `organization` table and put its id here — signup fails without it.
DEFAULT_ORGANIZATION_ID=

# Answering. The chat model is Gemini (`google:gemini-3.7-flash`), so
# GOOGLE_API_KEY is what answers; OPENAI_API_KEY runs the domain-locked web
# search, the opening suggestions and the follow-up questions. Both are needed
# for the product to work end to end.
GOOGLE_API_KEY=
OPENAI_API_KEY=


# ─── Sign-in with Google ─────────────────────────────────────────────────────
# See “Signing in with Google” in README.md for how to obtain these. Leave them
# empty to run with email sign-in only; the Google button hides itself.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ─── Email ───────────────────────────────────────────────────────────────────
# `smtp` or `resend`. Verification codes and sign-in links go out over this; with
# neither configured, email sign-in cannot complete.
EMAIL_TRANSPORT=smtp
EMAIL_FROM=Rfeeq <no-reply@example.com>

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# …or Resend instead of SMTP
RESEND_API_KEY=


# ─── Optional ────────────────────────────────────────────────────────────────

# Rate limiting. Without it the limiter is a no-op — fine locally, not in public.
REDIS_URL=
REDIS_TOKEN=

# File uploads and avatars.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_BUCKET=
ASSETS_S3_BUCKET=
ASSETS_S3_URL=
IMAGES_S3_BUCKET=

# Billing. Not reached on a deployment that does not sell anything.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=

# The port the dev server binds. Defaults to 3000.
PORT=3000
